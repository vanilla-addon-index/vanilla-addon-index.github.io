{
	"name": "vanilla-addon-index",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "node --test \"tests/*.test.mjs\"",
		"local": "node scripts/local.mjs up",
		"local:stop": "node scripts/local.mjs down",
		"dev:local": "vite dev --mode localdb --port 5174 --strictPort",
		"test:e2e": "node scripts/local.mjs up && playwright test",
		"snapshot": "node scripts/export.mjs",
		"nightly:token": "node scripts/nightly-token.mjs",
		"db:new": "supabase migration new",
		"db:status": "supabase migration list --linked",
		"db:push": "supabase db push --linked",
		"db:backup": "node scripts/backup.mjs",
		"db:backup:check": "node scripts/backup.mjs check",
		"db:backup:fetch": "node scripts/backup.mjs fetch",
		"db:baseline": "supabase migration repair --linked --status applied 20261011000001 20261011000002 20261011000003 20261011000004 20261011000005 20261011000006 20261011000007 20261011000008 20261011000009 20261011000010 20261011000011",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@fontsource/pt-sans-narrow": "^5.3.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"supabase": "^2.120.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.117.3"
	}
}
