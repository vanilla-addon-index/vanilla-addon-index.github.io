node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local environment values, including test credentials. Only the example is source.
.env
.env.*
!.env.example
.envrc
.direnv/

# Local credentials and private keys
.netrc
.npmrc.local
*.pem
*.key
*.p12
*.pfx

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# The daily snapshot of the addon list. The deploy keeps it on the "snapshot" branch;
# `npm run snapshot` fetches one for this computer.
/static/addons.json

# Wiki import dry-run output
/wiki-import

# Local tooling and editor settings
.claude/
.codex/
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Caches, coverage and scratch output
.cache/
.nyc_output/
coverage/
*.tsbuildinfo
/tmp/
/temp/

# Editor backups and merge leftovers
*~
*.swp
*.swo
*.bak
*.orig
*.rej

# File sync leftovers
.stfolder
.stversions
.stignore
*.sync-conflict-*

# Local copy of the backend (scripts/local.mjs). The database itself lives in Docker,
# outside this folder; these are the command-line tool's own leftovers. The address and
# key of the local copy are in .env.localdb, covered by .env.* above.
supabase/.temp
supabase/.branches
supabase/snippets

# Browser test output: traces, screenshots and reports
/test-results
/playwright-report
/blob-report
/playwright/.cache
/playwright/.auth

# Full backups of the hosted database (scripts/backup.mjs). Private data: never commit.
/backups

# Database copies can also be written to an explicitly chosen file outside /backups.
# Keep SQL source migrations; dumps (including compressed/encrypted copies) stay local.
*.sql
!/supabase/migrations/*.sql
*.sql.*
*.dump
*.dump.*
*.backup
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
